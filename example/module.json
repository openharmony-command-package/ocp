{
  "app": {
    "bundleName": "com.richerfu.ocp.example",
    "vendor": "ocp",
    "versionCode": 1,
    "versionName": "0.1.0",
    "minCompatibleVersionCode": 1,
    "minAPIVersion": 24,
    "targetAPIVersion": 26,
    "apiReleaseType": "Release",
    "debug": true,
    "bundleType": "app",
    "icon": "$media:ocp",
    "label": "$string:app_name"
  },
  "module": {
    "name": "entry",
    "type": "entry",
    "mainElement": "OcpAbility",
    "virtualMachine": "ark",
    "pages": "$profile:main_pages",
    "abilities": [
      {
        "name": "OcpAbility",
        "srcEntry": "./ets/entryability/OcpAbility.js",
        "exported": true
      }
    ],
    "deviceTypes": [
      "2in1",
      "tablet",
      "phone"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "compileMode": "esmodule",
    "requestPermissions": [
      {"name": "ohos.permission.ALLOW_USE_BM"},
      {"name": "ohos.permission.ALLOW_EXTERNAL_NATIVE_CODE"},
      {"name": "ohos.permission.INTERNET"}
    ],
    "packageName": "entry"
  }
}
