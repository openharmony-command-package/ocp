{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"OCP registry protocol 2","type":"object","required":["schema_version","tap","packages"],
  "properties":{
    "schema_version":{"const":2},
    "tap":{"type":"string","pattern":"^[a-z][a-z0-9_]*$"},
    "packages":{"type":"array","minItems":1,"items":{"type":"object","required":["name","version","abi","bundle","hnp_name","commands","hap_sha256","bottle_path"],"properties":{
      "name":{"type":"string","pattern":"^[A-Za-z0-9_-]+$"},
      "version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
      "abi":{"enum":["arm64-v8a","x86_64","armeabi-v7a"]},
      "bundle":{"type":"string"},"hnp_name":{"type":"string"},
      "commands":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^[A-Za-z0-9_][A-Za-z0-9_.+-]*$"}},
      "hap_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
      "upstream":{"type":"string"},
      "publisher":{"type":"object","required":["name"],"properties":{"name":{"type":"string","minLength":1,"maxLength":128},"url":{"type":"string","pattern":"^https?://"}}},
      "signing":{"enum":["emulator-debug","provided-signed-hap","unsigned-development"]},
      "bottle_path":{"type":"string"}
    }}}
  }
}
